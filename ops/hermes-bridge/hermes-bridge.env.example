# Hermes Kanban Bridge Environment Configuration
# Location: /etc/legion-dashboard/hermes-bridge.env
# 
# This file is sourced by the systemd service or read by the bridge at startup.
# Currently all configuration is hardcoded for security, but this file is
# reserved for future configuration options.

# Path to Hermes CLI binary
# Default: /usr/local/lib/hermes-agent/venv/bin/hermes
# HERMES_CLI_PATH=/usr/local/lib/hermes-agent/venv/bin/hermes

# Default Kanban board
# Default: legion-apps-build-queue
# KANBAN_BOARD=legion-apps-build-queue

# Bind port
# Default: 8765
# BIND_PORT=8765

# Bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Default: 0.0.0.0
# BIND_ADDRESS=0.0.0.0

# Request body size limit in bytes
# Default: 50000 (50KB)
# MAX_BODY_SIZE=50000
