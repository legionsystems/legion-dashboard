[Unit]
Description=LEGION Preview Deployment Executor (host-side)
Documentation=https://github.com/legionsystems/legion-dashboard/tree/main/ops/host-executor
After=network.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# API_SERVER_KEY is loaded from an EnvironmentFile so the secret never
# appears on the command line or in systemd journal headers. The file
# must be root:root and mode 0600 — operator provisions it during host
# bootstrap (see ops/host-executor/README for the expected shape).
#
# The same EnvironmentFile is where the operator sets
# LEGION_EXECUTOR_ALLOWED_REPO_ROOTS (comma-separated absolute paths)
# when onboarding a new app. The executor falls back to its built-in
# defaults when the variable is unset.
EnvironmentFile=/etc/legion/preview-executor.env
# ExecStart points at the source-controlled copy in /srv/repo/legion-dashboard
# so a normal ``git pull`` + ``systemctl restart legion-preview-executor`` is
# enough to roll forward — the older runtime under /root/.hermes/LEGION_TOOLS
# is no longer the source of truth. Operators upgrading from the legacy path
# must run ``systemctl daemon-reload`` once after pulling this unit change.
ExecStart=/usr/bin/python3 /srv/repo/legion-dashboard/ops/host-executor/legion-preview-executor
Restart=on-failure
RestartSec=5

# Logging — keep stderr out of the journal at INFO and use a dedicated
# log file so the dashboard's debug loop can tail it without sudo.
StandardOutput=append:/var/log/legion-preview-executor.log
StandardError=append:/var/log/legion-preview-executor.log

# Security hardening. The executor must be able to:
#   * write inside /srv/repo (git checkout — legacy single-app layout)
#   * write inside /srv/worktrees (per-app git worktrees; required by
#     LEGION_EXECUTOR_ALLOWED_REPO_ROOTS entries such as
#     /srv/worktrees/legion-dashboard so operators can onboard new
#     apps without editing this unit). The leading ``-`` marks the
#     path optional so legacy hosts that have not yet provisioned
#     /srv/worktrees can still start the service; once the directory
#     exists systemd adds it to the writable set on the next restart.
#   * talk to /var/run/docker.sock (docker compose)
#   * append to its own log file
# Anything else is read-only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/repo /var/log /var/run/docker.sock
ReadWritePaths=-/srv/worktrees
PrivateTmp=true

# Resource limits — the executor itself is small; docker compose does
# the heavy lifting in separate containers.
MemoryMax=512M
CPUQuota=75%

[Install]
WantedBy=multi-user.target
