APP_ID=legion-dashboard
APP_NAME=LEGION Dashboard
APP_VERSION=0.1.0

# App container port published on the host
APP_HOST_PORT=8720

# Postgres
POSTGRES_USER=legion
POSTGRES_PASSWORD=legion
POSTGRES_DB=legion_dashboard

# Backend DB connection (inside docker network)
DATABASE_URL=postgresql+psycopg2://legion:legion@db:5432/legion_dashboard
